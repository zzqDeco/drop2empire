# Drop to Empire (滴水成城 · D2E) Production Configuration
# Copy to /srv/drop2empire/config/production.env (mode 0600)
# Isolated from /srv/teamie and ports 80/443.

PUBLIC_HTTPS_PORT=8443
ADMIN_TUNNEL_PORT=18480
TLS_CERT_DIR=/srv/drop2empire/tls
LOG_LEVEL=info
POSTGRES_USER=drop2empire
POSTGRES_DB=drop2empire
POSTGRES_PASSWORD=replace-with-random-url-safe-secret
